# supabase/functions/.env.example
# These are set automatically in the Supabase dashboard under
# Project Settings > Edge Functions > Secrets
# Do NOT commit actual values to source control

# Auto-injected by Supabase runtime — no action needed:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set in Supabase Edge Function secrets (same value as Auth → Hooks → secret):
# AUTH_HOOK_SECRET=v1,whsec_...
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
# QPay configuration for payment gateway integration
QPAY_API_BASE_URL=https://api.qpay.com.qa/v1
QPAY_MERCHANT_ID=your-qpay-merchant-id
QPAY_API_KEY=your-qpay-api-key
QPAY_SECRET_KEY=your-qpay-secret-key
QPAY_WEBHOOK_SECRET=your-qpay-webhook-secret
QPAY_WEBHOOK_URL=https://your-supabase-project-id.functions.supabase.co/qpay-webhook
CUSTOMER_APP_URL=https://order.restaurant.qa
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
# Replace re_xxxxxxxxx with your real Resend API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=ops@example.com
OPERATOR_SECRETS_MASTER_KEY=replace-with-a-long-random-secret
