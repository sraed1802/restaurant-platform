# Supabase hosted Edge Functions automatically receive these at runtime:
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
#
# Do not paste those into Netlify browser variables.

# Core production values
CUSTOMER_APP_URL=https://order.restaurant.qa
OPERATOR_SECRETS_MASTER_KEY=replace-with-a-long-random-secret

# Netlify cache invalidation (used by supabase/functions/invalidate-cache)
NETLIFY_AUTH_TOKEN=your-netlify-personal-access-token
NETLIFY_SITE_ID=your-customer-netlify-site-id

# Payment gateways (set only if you use them in production)
QPAY_API_BASE_URL=https://api.qpay.com.qa/v1
QPAY_MERCHANT_ID=your-qpay-merchant-id
QPAY_API_KEY=your-qpay-api-key
QPAY_SECRET_KEY=your-qpay-secret-key
QPAY_WEBHOOK_SECRET=your-qpay-webhook-secret
QPAY_WEBHOOK_URL=https://your-project-ref.functions.supabase.co/qpay-webhook

STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Messaging / email integrations (set only if you use them in production)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=ops@your-domain.com

# Notes:
# - If you want the runtime to stay as close as possible to only Netlify + Supabase,
#   leave payment, SMS, email, and Sentry integrations disabled unless they are required.
# - Public customer email auth still needs a production SMTP/email provider in Supabase Auth.
