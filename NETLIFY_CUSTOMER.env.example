# Netlify site: customer
# Base directory: apps/customer
# Build command: npm run build
# Publish directory: dist
# Edge functions directory: ../../netlify/edge-functions
#
# PUBLIC values (available in the browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
VITE_SITE_URL=https://order.restaurant.qa

# Optional browser values
# VITE_DELIVERY_FEE=5.00
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=customer@1.0.0

# Optional tenant pinning for single-tenant deployments
# VITE_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# VITE_CLUSTER_ID=00000000-0000-0000-0000-000000000000
# VITE_PROPERTY_ID=00000000-0000-0000-0000-000000000000

# PRIVATE values (Netlify Edge Functions only; never expose in VITE_* vars)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Notes:
# - Every VITE_* variable is public by design.
# - SUPABASE_SERVICE_ROLE_KEY must only exist in server-side/edge runtime.
# - Leave Sentry unset if you want to keep production runtime strictly Netlify + Supabase.
