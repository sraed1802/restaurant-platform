# Netlify site: driver
# Base directory: apps/driver
# Build command: (from netlify.toml) cd ../.. && npm ci && npm run build:driver
# Publish directory: dist

# PUBLIC values (available in the browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Optional browser values
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=driver@1.0.0

# Optional tenant pinning for single-tenant deployments
# VITE_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# VITE_CLUSTER_ID=00000000-0000-0000-0000-000000000000
# VITE_PROPERTY_ID=00000000-0000-0000-0000-000000000000

# Notes:
# - Driver login uses email/password (no magic-link redirect URLs required on this site).
# - Set the same Supabase project as customer/admin.
# - Recommended production domain: https://driver.restaurant.qa
# - In the admin Netlify site, set VITE_DRIVER_PORTAL_URL to this site's public URL.
