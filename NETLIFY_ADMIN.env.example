# Netlify site: admin
# Base directory: (empty = repository root)
# Config file: apps/admin/netlify.toml
# Publish directory: apps/admin/dist

# PUBLIC values (available in the browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
VITE_CUSTOMER_ORIGIN=https://order.restaurant.qa
VITE_DRIVER_PORTAL_URL=https://driver.restaurant.qa

# Optional browser values
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=admin@1.0.0

# Optional tenant pinning for single-tenant deployments
# VITE_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# VITE_CLUSTER_ID=00000000-0000-0000-0000-000000000000
# VITE_PROPERTY_ID=00000000-0000-0000-0000-000000000000

# Notes:
# - This app does not currently require private Netlify runtime variables from the codebase.
# - Leave Sentry unset if you want to keep production runtime strictly Netlify + Supabase.
