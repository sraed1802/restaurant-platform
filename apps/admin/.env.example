# apps/admin/.env.example
# Copy to .env.local and fill in your Supabase project values

# Must be your Supabase REST/Auth API URL (Dashboard → Project Settings → API → Project URL).
# Example: https://abcdefghijklmnop.supabase.co — NOT your Vite dev URL or a Cloudflare tunnel to the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry error tracking
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=admin@1.0.0

# The admin app uses the anon key + JWT role claims for auth.
# Never expose the service_role key in any frontend app.
# Get your values from: Supabase Dashboard → Project Settings → API

# --- Multi-tunnel dev (optional; Cloudflare quick tunnel URLs change each run) ---
# When Admin runs on its own tunnel (e.g. https://domestic-remedy-flame-qualifying.trycloudflare.com) but Driver
# runs on another (e.g. https://suggested-cloth-environmental-rules.trycloudflare.com), set the driver origin so
# “Open driver portal” / copy-link in Drivers resolves correctly:
# VITE_DRIVER_PORTAL_URL=https://suggested-cloth-environmental-rules.trycloudflare.com
#
# Settings → guest app preview iframe — must match the customer app public URL.
# Use either name (VITE_CUSTOMER_ORIGIN preferred); copy the same URL as apps/customer VITE_SITE_URL.
# VITE_CUSTOMER_ORIGIN=https://acrobat-packs-radical-reflected.trycloudflare.com
# VITE_SITE_URL=https://acrobat-packs-radical-reflected.trycloudflare.com
VITE_DRIVER_PORTAL_URL=
VITE_CUSTOMER_ORIGIN=
# VITE_SITE_URL=
