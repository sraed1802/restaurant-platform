# Copy to keystore.properties (gitignored) before release builds.
# Generate keystore (once per app or one shared keystore with different aliases):
#   keytool -genkey -v -keystore release.keystore -alias maazym-customer -keyalg RSA -keysize 2048 -validity 10000
#
# Path is relative to apps/<app>/android/
storeFile=../release.keystore
storePassword=CHANGE_ME
keyAlias=maazym-customer
keyPassword=CHANGE_ME
