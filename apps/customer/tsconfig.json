{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "../../types": ["./types.ts"],
      "@rms/platform": ["../../packages/platform/src/index.ts"],
      "@rms/platform/*": ["../../packages/platform/src/*"],
      "@rms/supabase": ["../../packages/supabase/client.ts"],
      "@rms/supabase/*": ["../../packages/supabase/*"],
      "@rms/admin/*": ["../admin/src/*"],
      "@rms/driver/*": ["../driver/src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src"]
}
