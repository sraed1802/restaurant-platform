# apps/customer/.env.example
# Copy to .env.local and fill in your Supabase project values

VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Auth (email magic link — no SMS cost): add these URLs under Supabase Dashboard → Authentication → URL Configuration:
# - Site URL: e.g. http://localhost:5173 for dev
# - Redirect URLs: http://localhost:5173/auth/callback and your production origin + /auth/callback
#
# Testing magic links on a phone: localhost in the email points at the phone itself and will NOT work.
# Set this to your PC's LAN URL so links open on Wi‑Fi (same network), then add the same URL + /auth/callback in Supabase:
# VITE_SITE_URL=http://192.168.1.10:5173
# Or use an HTTPS tunnel (ngrok, Cloudflare quick tunnel) and put that origin here + in Redirect URLs.
#
# Example — three separate `cloudflared tunnel --url http://localhost:PORT` sessions (URLs change each run):
#   Customer  VITE_SITE_URL=https://heaven-rides-barbara-joins.trycloudflare.com
#   Admin     (own origin; no VITE_SITE_URL unless you add app-specific keys)
#   Driver    set VITE_DRIVER_PORTAL_URL in apps/admin/.env when copying driver links from the Admin app
# Add each live origin + /auth/callback under Supabase → Authentication → URL Configuration → Redirect URLs.
VITE_SITE_URL=
#
# Confirm-address email (signup step 1):
# - Dashboard → Authentication → Providers → Email: enable "Confirm email" so Supabase sends the signup confirmation.
# - Authentication → SMTP: use a real provider for production; check Authentication → Logs if sends fail or hit rate limits.
# - Redirect URLs must include this origin + /auth/callback (match VITE_SITE_URL when set, or the deployed site origin).


# Optional: Override the fixed delivery fee displayed client-side
# Actual fee is enforced server-side via system_config table
VITE_DELIVERY_FEE=5.00

# Sentry error tracking
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=customer@1.0.0

# --- Native trio: customer app opens separate Admin / Driver APKs (no embedded super-app) ---
# Android package IDs (defaults match apps/admin and apps/driver capacitor.config.ts appId):
# VITE_ANDROID_ADMIN_PACKAGE=com.hostera.admin
# VITE_ANDROID_DRIVER_PACKAGE=com.hostera.driver
# Web / simulator fallback when "Open admin" is tapped outside Android native:
# VITE_ADMIN_WEB_URL=https://your-admin-host.example/
# VITE_DRIVER_WEB_URL=https://your-driver-host.example/

# Optional: Google Maps API key for address autocomplete (future feature)
# VITE_GOOGLE_MAPS_API_KEY=
